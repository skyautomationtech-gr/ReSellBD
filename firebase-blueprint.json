{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "shopName": { "type": "string", "maxLength": 100 },
        "shopNameKey": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "division": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "address": { "type": "string", "maxLength": 300 },
        "profilePhotoUrl": { "type": "string" },
        "shopPhotoUrl": { "type": "string" },
        "nidUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "reseller"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "rejectReason": { "type": "string" },
        "appLockEnabled": { "type": "boolean" },
        "appLockPinLength": { "type": "number" },
        "securityPrefs": {
          "type": "object",
          "properties": {
            "loginAlertsEnabled": { "type": "boolean" },
            "newDeviceAlertsEnabled": { "type": "boolean" },
            "alertChannels": {
              "type": "object",
              "properties": {
                "push": { "type": "boolean" },
                "email": { "type": "boolean" }
              }
            },
            "sessionTimeoutMinutes": { "type": "number", "enum": [0, 15, 30, 60, 240] },
            "sessionTimeoutAction": { "type": "string", "enum": ["lock", "logout"] },
            "updatedAt": { "type": "timestamp" }
          }
        },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "fullName", "shopName", "mobile", "email", "role", "status"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Active physical device session and trust status under a user",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "platform": { "type": "string", "enum": ["android", "ios", "web"] },
        "os": { "type": "string" },
        "osVersion": { "type": "string" },
        "browser": { "type": "string" },
        "model": { "type": "string" },
        "appVersion": { "type": "string" },
        "deviceType": { "type": "string", "enum": ["phone", "tablet", "laptop"] },
        "status": { "type": "string", "enum": ["active", "signed_out", "inactive"] },
        "activeSessionId": { "type": "string" },
        "trusted": { "type": "boolean" },
        "trustedAt": { "type": "timestamp" },
        "trustedByDeviceId": { "type": "string" },
        "lastActive": { "type": "timestamp" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["deviceId", "deviceName", "platform", "status"]
    },
    "LoginHistoryEntry": {
      "title": "LoginHistoryEntry",
      "description": "Ephemeral recent sign-in activity record retained for 60 minutes",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "platform": { "type": "string" },
        "os": { "type": "string" },
        "osVersion": { "type": "string" },
        "browser": { "type": "string" },
        "deviceType": { "type": "string", "enum": ["phone", "tablet", "laptop"] },
        "isNewDevice": { "type": "boolean" },
        "location": { "type": "string" },
        "network": { "type": "string" },
        "timestamp": { "type": "timestamp" },
        "expireAt": { "type": "timestamp" }
      },
      "required": ["deviceId", "deviceName", "platform", "timestamp"]
    },
    "ShopNameReservation": {
      "title": "ShopNameReservation",
      "description": "Unique shop name reservation entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "shopName": { "type": "string" },
        "shopNameKey": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "shopName", "shopNameKey", "createdAt"]
    },
    "PhoneChangeRequest": {
      "title": "PhoneChangeRequest",
      "description": "Phone number change request submitted by reseller for admin review",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resellerName": { "type": "string" },
        "resellerId": { "type": "string" },
        "oldPhone": { "type": "string" },
        "newPhone": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "oldPhone", "newPhone", "reason", "status"]
    },
    "DeactivationRequest": {
      "title": "DeactivationRequest",
      "description": "Account deactivation request submitted by reseller for admin review",
      "type": "object",
      "properties": {
        "resellerId": { "type": "string" },
        "resellerName": { "type": "string" },
        "shopName": { "type": "string" },
        "mobile": { "type": "string" },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["resellerId", "reason", "status"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "Account permanent deletion request submitted by reseller for admin review",
      "type": "object",
      "properties": {
        "resellerId": { "type": "string" },
        "resellerName": { "type": "string" },
        "shopName": { "type": "string" },
        "mobile": { "type": "string" },
        "walletBalance": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["resellerId", "reason", "status"]
    },
    "EmailOtp": {
      "title": "EmailOtp",
      "description": "Server-only hashed email OTP verification record",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["reseller_registration", "super_admin_login"] },
        "uid": { "type": "string" },
        "hashedCode": { "type": "string" },
        "expiresAt": { "type": "timestamp" },
        "attemptsLeft": { "type": "number" },
        "lastSentAt": { "type": "timestamp" },
        "lockedUntil": { "type": "timestamp" }
      },
      "required": ["email", "type", "hashedCode", "expiresAt", "attemptsLeft", "lastSentAt"]
    },
    "ChangeRequest": {
      "title": "ChangeRequest",
      "description": "Verified/locked reseller information change request reviewed by Super Admin",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "uid": { "type": "string" },
        "resellerUid": { "type": "string" },
        "resellerId": { "type": "string" },
        "resellerName": { "type": "string" },
        "resellerCode": { "type": "string" },
        "field": { "type": "string", "enum": ["shopName", "email", "dob", "nid", "nid_image", "birth_certificate", "payout"] },
        "fieldKey": { "type": "string" },
        "fieldLabel": { "type": "string" },
        "oldValueMasked": { "type": "string" },
        "newValue": { "type": "string" },
        "newDocumentUrl": { "type": "string" },
        "proofUrl": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "decidedBy": { "type": "string" },
        "decidedAt": { "type": "timestamp" },
        "decisionNote": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["requestId", "uid", "fieldKey", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles collection"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "UserDevice",
      "description": "Active and trusted user device sessions"
    },
    "/users/{userId}/loginHistory/{historyId}": {
      "schema": "LoginHistoryEntry",
      "description": "Recent sign-in events retained for 60 minutes"
    },
    "/shopNames/{shopNameKey}": {
      "schema": "ShopNameReservation",
      "description": "Unique shop name reservations collection, Cloud Functions / server only"
    },
    "/emailOtps/{docId}": {
      "schema": "EmailOtp",
      "description": "Hashed email OTP records, Cloud Functions only (clients denied)"
    },
    "/phone_change_requests/{requestId}": {
      "schema": "PhoneChangeRequest",
      "description": "Phone number change approval requests"
    },
    "/deactivationRequests/{requestId}": {
      "schema": "DeactivationRequest",
      "description": "Account deactivation requests"
    },
    "/deletionRequests/{requestId}": {
      "schema": "DeletionRequest",
      "description": "Account permanent deletion requests"
    },
    "/changeRequests/{requestId}": {
      "schema": "ChangeRequest",
      "description": "Locked/verified reseller info change requests reviewed by Super Admin"
    }
  }
}
